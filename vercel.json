{
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/p/:type/:id", "destination": "/api/share" },
    { "source": "/live/:token", "destination": "/api/share" },
    { "source": "/t/:id", "destination": "/api/share" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/u/:id", "destination": "/index.html" }
  ],
  "functions": {
    "api/share.ts": { "includeFiles": "dist/index.html" }
  }
}
